generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Song {
  id               String    @id @default(cuid())
  youtubeUrl       String    @unique
  youtubeId        String    @unique
  title            String?
  artist           String?
  thumbnail        String?
  // Job tracking — set when a processing job is submitted to the Python worker
  currentJobId     String?
  processingStatus String?   // mirrors JobStatus: queued | processing | completed | failed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lyrics LyricLine[]
}

model LyricLine {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  lineIndex    Int
  startTime    Float?
  endTime      Float?
  acousticStart Float?
  acousticEnd   Float?
  japanese     String
  words     String?  // JSON: LyricWord[]  (word-level timestamps from WhisperX)
  tokens    String?  // JSON: Token[]      (morphological analysis)
  analysis  String?  // JSON: AnalysisResult (AI translation/breakdown)
  createdAt DateTime @default(now())

  @@index([songId, lineIndex])
}
