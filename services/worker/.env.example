# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Cache ──────────────────────────────────────────────────────────────────────
# Where to store downloaded audio, separated vocals, and lyrics.json results.
# Mount this as a Docker volume to persist across container restarts.
CACHE_DIR=./cache

# Path to the SQLite jobs database (defaults to CACHE_DIR/jobs.db)
# DB_PATH=./cache/jobs.db

# ── Whisper ────────────────────────────────────────────────────────────────────
# Model sizes (tradeoff: speed vs accuracy):
#   tiny | base | small | medium | large-v2 | large-v3 (default)
# large-v3 gives best Japanese accuracy but needs ~10 GB VRAM or slow on CPU.
# Use "medium" for a reasonable CPU-only experience.
WHISPER_MODEL=large-v3

# auto | cpu | cuda
WHISPER_DEVICE=auto

# auto | int8 | float16 | float32
# int8   = fastest, slight quality loss  (good for CPU)
# float16= fast, full quality            (good for CUDA)
WHISPER_COMPUTE_TYPE=auto

# Batch size — reduce if you run out of memory
WHISPER_BATCH_SIZE=16

# Language — always ja for this app
WHISPER_LANGUAGE=ja

# ── Demucs ─────────────────────────────────────────────────────────────────────
DEMUCS_MODEL=htdemucs

# Set to true to skip vocal separation (faster, less accurate for noisy songs)
SKIP_VOCAL_SEPARATION=false

# ── Audio processing ───────────────────────────────────────────────────────────
# EBU R128 loudness normalisation target (LUFS). -23 = broadcast standard.
AUDIO_LUFS_TARGET=-23
# True peak ceiling (dBTP)
AUDIO_TRUE_PEAK=-1
# Sample rate for Demucs-input WAV (Hz). 44100 = Demucs native rate.
AUDIO_SAMPLE_RATE=44100
# Trim leading/trailing silence before processing
TRIM_SILENCE=true
SILENCE_THRESHOLD=-60dB
SILENCE_DURATION=0.5

# ── Cache ───────────────────────────────────────────────────────────────────────
# Evict cache entries not accessed for longer than this many days
CACHE_MAX_AGE_DAYS=30
# Keep raw audio after processing (avoids re-downloading on re-runs)
KEEP_AUDIO=true

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
